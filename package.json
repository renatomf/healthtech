{
  "name": "healthtech",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "db:generate": "pnpm --filter @healthtech/api db:generate",
    "db:migrate": "pnpm --filter @healthtech/api db:migrate",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "depcruise": "depcruise apps packages --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "verify": "pnpm lint && pnpm typecheck && pnpm depcruise && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^26.6.6",
    "dependency-cruiser": "^18.7.2",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
