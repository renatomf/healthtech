# Copie para .env e ajuste. NUNCA commite o .env.

# --- Banco ---
POSTGRES_USER=clinic
POSTGRES_PASSWORD=clinic_dev_password
POSTGRES_DB=clinic
# Porta do banco no host: fora da faixa de portas efêmeras do Linux e do Windows e longe da 5432 padrão
POSTGRES_HOST_PORT=15432
DATABASE_URL=postgres://clinic:clinic_dev_password@localhost:15432/clinic

# --- API ---
NODE_ENV=development
API_PORT=3333
# Gere um valor aleatório com pelo menos 32 bytes (ex.: openssl rand -base64 48)
JWT_SECRET=troque-por-um-segredo-aleatorio-de-pelo-menos-32-bytes
JWT_EXPIRES_IN=8h
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# --- Regras da clínica ---
CLINIC_TIMEZONE=America/Sao_Paulo
CLINIC_OPEN_TIME=08:00
CLINIC_CLOSE_TIME=18:00
# Slots têm 30 min fixos (enunciado + CHECK chk_slot_aligned); horários acima em :00 ou :30.

# --- Web ---
VITE_API_URL=http://localhost:3333
